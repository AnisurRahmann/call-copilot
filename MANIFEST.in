# Include docs + metadata in the source distribution (sdist). The wheel only
# needs the Python package under src/; the sdist also carries README, LICENSE,
# the Homebrew formula, and the release docs so the package is self-describing.
include README.md
include LICENSE
include CONTRIBUTING.md
include SECURITY.md
include CODE_OF_CONDUCT.md
include Makefile
# MCP registry metadata. server.json is the official MCP Registry metadata pack
# (registry.modelcontextprotocol.io); smithery.yaml is the Smithery build
# descriptor. Shipping them in the sdist keeps the package self-describing.
include server.json
include smithery.yaml
recursive-include docs *.md
recursive-include .github *.yml
# Ship the prompt templates so a Homebrew/sdist install can summarise.
recursive-include src/rec/prompts *.md
